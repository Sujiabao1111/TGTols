# ============================================
# TOLS Docker 部署环境变量配置
# ============================================
# 把 .env.docker 复制为 .env，然后填入真实值
#
# 注意：
#   - NEXT_PUBLIC_ 开头的变量会在构建时内联到前端代码中
#   - 其他变量在运行时生效
#   - DB_HOST 填宿主机的实际 IP（不是 127.0.0.1，因为容器内 127.0.0.1 是自己）
# ============================================

# --------------------------------------------
# 数据库连接配置（宝塔面板已安装的 MySQL / Redis）
# --------------------------------------------

# MySQL 主机地址
# 本地测试: host.docker.internal（容器访问宿主机）
# 服务器部署: 填宝塔服务器的实际内网/公网 IP，如 192.168.1.100
DB_HOST=host.docker.internal

# MySQL 端口
DB_PORT=3306

# MySQL root 密码
DB_PASSWORD=guesswhat

# 数据库名
DB_NAME=star

# Redis 主机地址
# 本地测试: host.docker.internal
# 服务器部署: 填宝塔服务器的实际 IP
REDIS_HOST=host.docker.internal

# Redis 端口
REDIS_PORT=6379

# BOAN M7PP 生产环境凭证（仅供后端容器使用）
# BOAN 白名单出口 IP: 47.239.73.75, 8.210.138.234, 47.242.164.130
BOAN_API_KEY=2wiX0NHkyrrJURICICfkqK5OkKOOO2sAeokOaAQasXNuLlPqz0gxwmcHDgcSbEth
BOAN_API_SECRET=Adby446h1IANfQxKMNePPC0HCfBinO2kj7uiSVi8L2bQU9T9wXxSZ1Re38JaEksq

# --------------------------------------------
# 前端配置
# --------------------------------------------

# 后端 API 地址（浏览器可访问）
# 本地测试: http://localhost:3555
# 服务器部署: https://你的域名/api
NEXT_PUBLIC_API_BASE_URL=

# Clerk 认证公钥（从 https://dashboard.clerk.com/ 获取）
# 示例: pk_test_xxxxxxxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_你的公钥

# Clerk 认证私钥（从 https://dashboard.clerk.com/ 获取）
# 示例: sk_test_xxxxxxxxxx
CLERK_SECRET_KEY=sk_test_你的私钥
